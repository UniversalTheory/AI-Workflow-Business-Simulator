# .env.local.example
#
# Copy this file to .env.local and fill in your actual keys.
# .env.local is gitignored — never commit real API keys.
#
# These are the keys you'll need as the project progresses:
#
# Phase 3 — Airtable & Webhook Integration
AIRTABLE_API_KEY=your_airtable_personal_access_token_here
AIRTABLE_BASE_WESTSIDE=appXXXXXXXXXXXXXX
AIRTABLE_BASE_BRIDGEWATER=appXXXXXXXXXXXXXX
AIRTABLE_BASE_RAPIDS_BITE=appXXXXXXXXXXXXXX

# Phase 5 — Claude API (AI-Assisted Profile Generation)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXX

# Phase 5 — Optional: SendGrid for test emails
SENDGRID_API_KEY=SG.XXXXXXXXXXXX
